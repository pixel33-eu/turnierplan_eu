{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "6.5"
  },
  "landingPage": "/wp-admin/plugins.php",
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "/wordpress/wp-content/plugins/turnierplan-eu"
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true,
        "SCRIPT_DEBUG": true,
        "WP_ENVIRONMENT_TYPE": "local",
        "TPEU_TEST_EXPECTED_THEME_KIND": "block"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/tmp/tpeu-tests/playground-release-smoke.php';"
    }
  ]
}
