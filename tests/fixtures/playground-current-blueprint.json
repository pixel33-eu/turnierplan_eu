{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.5",
    "wp": "7.0.7"
  },
  "landingPage": "/wp-admin/plugins.php",
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "activatePlugin",
      "pluginPath": "turnierplan-eu/turnierplan-eu.php"
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "wordpress.org/themes",
        "slug": "twentytwentyone"
      },
      "options": {
        "activate": true,
        "onError": "throw"
      }
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true,
        "SCRIPT_DEBUG": true,
        "WP_ENVIRONMENT_TYPE": "local",
        "TPEU_TEST_EXPECTED_THEME_KIND": "classic"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-content/plugins/turnierplan-eu/tests/fixtures/playground-rest-smoke.php';"
    }
  ]
}
