{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.turnierplan.eu/schemas/embed/v1/error-response.schema.json",
  "title": "Turnierplan embed error response V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid_reference",
            "invalid_parameter",
            "tournament_not_found",
            "view_unavailable",
            "rate_limited",
            "temporarily_unavailable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "request_id": {
          "type": "string",
          "pattern": "^req_[0-9a-hjkmnp-tv-z]{26}$"
        },
        "parameter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "retry_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
